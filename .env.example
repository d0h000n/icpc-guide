# Copy to .env for local development. Never commit the real .env file.

DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=dev-insecure-change-me
DEBUG=True

# Local Postgres via docker compose. For SQLite quickstart, leave unset.
# DATABASE_URL=postgres://ps_tracker:ps_tracker@localhost:5432/ps_tracker

# OAuth credentials. Create them at:
#   - Google Cloud Console: https://console.cloud.google.com/apis/credentials
#       Authorized redirect URI: http://localhost:8000/accounts/google/login/callback/
#   - GitHub OAuth Apps:    https://github.com/settings/developers
#       Authorization callback URL: http://localhost:8000/accounts/github/login/callback/
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Production-only (do not set locally)
# ALLOWED_HOSTS=ps-tracker.fly.dev,your-domain.example
# CSRF_TRUSTED_ORIGINS=https://ps-tracker.fly.dev
# SENTRY_DSN=
